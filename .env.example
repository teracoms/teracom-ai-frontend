NEXT_PUBLIC_SITE_URL=https://www.teracomsolutions.com.au

# Teracom AI backend (teracom-ai-backend). Server-only — deliberately not
# prefixed NEXT_PUBLIC_ so it is never inlined into the browser bundle; the
# browser only ever talks to this Next.js app's own /api routes, which proxy
# to this URL server-side. See FRONTEND_ARCHITECTURE_V1.md §C.4.
BACKEND_API_URL=http://localhost:8000

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Zoho Books - Australia data centre
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com.au
ZOHO_BOOKS_BASE_URL=https://www.zohoapis.com.au/books/v3
ZOHO_CLIENT_ID=replace_me
ZOHO_CLIENT_SECRET=replace_me
ZOHO_REFRESH_TOKEN=replace_me
ZOHO_ORGANIZATION_ID=replace_me

# Admin import protection
ADMIN_IMPORT_TOKEN=replace_with_a_long_random_string

# Commerce-to-Licensing Lifecycle Automation, Phase 1 (Wave 2 Workstream 5).
# Shared secret sent as X-Internal-Service-Token when app/api/webhooks/stripe/
# route.js calls teracom-ai-backend's internal /internal/licence-billing-
# references/* endpoints. Must exactly match that backend's own
# INTERNAL_SERVICE_TOKEN — this is a server-to-server credential, never a
# session token, and neither side accepts a blank value.
INTERNAL_SERVICE_TOKEN=replace_with_a_long_random_string
