NEXT_PUBLIC_SITE_URL=https://app.teracomsolutions.com.au

# Teracom AI backend (teracom-ai-backend). Server-only — deliberately not
# prefixed NEXT_PUBLIC_ so it is never inlined into the browser bundle; the
# browser only ever talks to this Next.js app's own /api routes, which proxy
# to this URL server-side. See FRONTEND_ARCHITECTURE_V1.md §C.4.
BACKEND_API_URL=http://localhost:8000
